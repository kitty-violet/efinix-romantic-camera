# Keep all supplied r15 project, ROM, firmware and simulation assets.
!/fpga/project/outflow/
!/fpga/project/outflow/**
!/fpga/project/*.bin
!/fpga/project/*.hex
!/fpga/firmware/prebuilt/*.bin
!/fpga/tests/data/*.hex

# Complete-package delivery assets, not locally generated build output.
!/fpga/network/**/*.bin
!/fpga/network/**/*.hex
!/fpga/original_sources/output/
!/fpga/original_sources/output/**
!/fpga/verification/core/*.log

