# Asynchronous SW0, actual two-FF debounce synchronizer audited separately.
set_false_path -from [get_ports {service_key_n}]

# UI92 uses one registered completion toggle and a two-stage mode synchronizer; no multi-bit FPS Gray bus.

# SW3 external async button; only the physical pin to actual first synchronizer.
set_false_path -from [get_ports {view_key_n}] -to [get_pins {service_view_control/debounce/key_meta~FF|D}]
# SW2 is asynchronous; only the first synchronizer D is excepted.
set_false_path -from [get_ports {style_key_n}] -to [get_pins {style196_button/key_meta~FF|D}]

# Read-only SPI: SCLK is registered data, not an FPGA clock. HALF_PERIOD=16
# at 150 MHz gives 106.656 ns between external edges. It can pause low.
# Bound real FPGA I/O paths to 20 ns each; add 10 ns board budget per leg,
# 7 ns Flash tCLQV, and 3 core cycles for the two-FF sampling pipeline.
# Round-trip bound 87 ns < 213.312 ns available to the sampling state.
# MOSI/CS minimum edge separation minus worst 30 ns output skew is >76 ns.
# These apply ONLY to external ports. No internal setup/hold is relaxed.
# MISO is an asynchronous external input into exactly two preserved FFs;
# its first-to-second FF path retains normal 150 MHz setup and hold.
# Efinity requires an I/O reference before max/min path budgets are analyzed.
# Virtual reference is only an accounting origin for four external paths;
# zero external delay makes the existing 20/0 ns bounds FPGA-only budgets.
# Actual Flash edge, board flight and two-stage synchronization budgets are
# verified separately. No internal clock relation or FF path is excepted.
create_clock -name flash_path_budget -period 213.333333
set_input_delay -clock flash_path_budget 0.000 [get_ports {flash_miso}]
set_output_delay -clock flash_path_budget 0.000 [get_ports {flash_cs_n flash_sclk flash_mosi}]
set_max_delay -from [get_ports {flash_miso}] -to [get_pins {rv32_control/miso_meta~FF|D}] 20.000
set_min_delay -from [get_ports {flash_miso}] -to [get_pins {rv32_control/miso_meta~FF|D}] 0.000
set_max_delay -to [get_ports {flash_cs_n flash_sclk flash_mosi}] 20.000
set_min_delay -to [get_ports {flash_cs_n flash_sclk flash_mosi}] 0.000

# Asynchronous UART RX only to the first synchronizer stage.
set_false_path -from [get_ports {ble_uart_rx}] -to [get_pins {ble_rx/rx_meta~FF|D}]

