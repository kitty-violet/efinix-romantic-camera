# Explicit exceptions for asynchronous protocol, reset, status, and hard-block
# sideband pins. These are intentionally not fabricated board-delay numbers.
# MIPI CSI-2 LP state is sampled by the CSI controller's internal CDC stages.
set_false_path -from [get_ports {i_cam_ck_LP_P_IN i_cam_ck_LP_N_IN cam_d0_LP_P_IN cam_d0_LP_N_IN cam_d1_LP_P_IN cam_d1_LP_N_IN cam_d2_LP_P_IN cam_d2_LP_N_IN cam_d3_LP_P_IN cam_d3_LP_N_IN}]
set_false_path -to [get_ports {o_cam_ck_HS_TERM o_cam_ck_HS_ENA cam_d0_HS_TERM cam_d0_HS_ENA cam_d1_HS_TERM cam_d1_HS_ENA cam_d2_HS_TERM cam_d2_HS_ENA cam_d3_HS_TERM cam_d3_HS_ENA}]

# External reset and PLL lock signals are asynchronous control/status signals.
set_false_path -from [get_ports {i_arstn i_pll_locked pll_locked user_pll_locked process_pll_locked}]
set_false_path -to [get_ports {pll_inst1_RSTN USER_PLL_RSTN DDR3_PLL_RSTN}]

# The camera I2C bus is asynchronous and internally double-sampled at CLK_5M.
# I2C protocol timing is verified separately from synchronous I/O STA.
set_false_path -from [get_ports {io_cam_scl_IN io_cam_sda_IN}]
set_false_path -to [get_ports {io_cam_scl_OUT io_cam_scl_OE io_cam_sda_OUT io_cam_sda_OE}]

# RUNTEST and TMS are retained only because the hard JTAG interface requires the
# ports; debug_edb_top ties both functions low. TDI remains fully constrained.


# Static/protocol control outputs and PLL dynamic-phase sideband signals do not
# have an external synchronous capture clock at the fabric/periphery boundary.
set_false_path -to [get_ports {led[*] o_cam_rst_p ddr_reset_n}]
set_false_path -to [get_ports {pll_shift[*] pll_shift_sel[*] pll_shift_ena}]

# DDR PLL_TR0 and user PLL_BR0 have no guaranteed relative phase.
# Retain related DDR200/DDR400 phase requirements and every same-domain check.
set_clock_groups -asynchronous -group {process_clk_150} -group {tx_cal_clk_90edge sdram_clk rx_cal_clk ddr_core_clk200}
# Explicit Gray first-stage bus skew: stricter than the slow 150MHz period.
