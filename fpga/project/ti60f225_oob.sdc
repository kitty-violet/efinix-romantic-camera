# CANDIDATE: regenerate physical I/O constraints with Interface Designer before STA.
# PLL Constraints
#################
# PLL Constraints
#################

create_clock -waveform {0.625 1.875} -period 2.500 -name tx_cal_clk_90edge [get_ports {tx_cal_clk_90edge}]
create_clock -period 2.500 -name sdram_clk [get_ports {sdram_clk}]
create_clock -period 2.500 -name rx_cal_clk [get_ports {rx_cal_clk}]
create_clock -period 5.000 -name ddr_core_clk200 [get_ports {ddr_core_clk200}]
create_clock -period 20.000 -name ddr_feedback50 [get_ports {ddr_feedback50}]
create_clock -period 13.468 -name vid_clk_dvi2 [get_ports {vid_clk_dvi2}]
# Standard 1920x1080p30 CTA timing uses a 74.25 MHz pixel/TMDS-symbol clock.
create_clock -period 13.468 -name hdmi_tx_slow_clk [get_ports {hdmi_tx_slow_clk}]
create_clock -period 18.519 -name fb [get_ports {fb}]
create_clock -waveform {0.674 2.021} -period 2.694 -name hdmi_tx_fast_clk [get_ports {hdmi_tx_fast_clk}]
create_clock -period 10.000 -name core_clk [get_ports {core_clk}]
create_clock -period 20.000 -name i_mipi_rx_pclk [get_ports {i_mipi_rx_pclk}]
# The PLL output is exactly 600/4 = 150.000 MHz.  Use a slightly tighter
# 6.666 ns analysis period (150.015 MHz) so decimal rounding never makes the
# STA constraint more permissive than the physical clock.
create_clock -period 6.666 -name process_clk_150 [get_ports {process_clk_150}]
create_clock -period 199.980 -name CLK_5M [get_ports {CLK_5M}]
create_clock -period 37.037 -name CLK_27M [get_ports {CLK_27M}]
create_clock -period 40.000 -name CLK_25M [get_ports {CLK_25M}]
create_clock -period 100.000 -name jtag_inst1_TCK [get_ports {jtag_inst1_TCK}]

# The coexistence pressure harness toggles a diagnostic bit in CLK_25M and
# samples it through a two-flop async_reg synchronizer in process_clk_150.
# These clocks have no phase relationship; time the destination synchronizer
# internally, but do not impose a fabricated 2 ps inter-clock requirement.
set_clock_groups -asynchronous -group {CLK_25M} -group {process_clk_150}


create_clock -period 10.000 -name i_cam_ck_CLKOUT [get_ports {i_cam_ck_CLKOUT}]

set_clock_groups -asynchronous -group {i_mipi_rx_pclk} -group {jtag_inst1_TCK}
# The direct RGB/reset crossing was removed.  Video pairs now cross only
# through rgb_pair_cdc_serializer's guarded dual-clock FIFO, whose Gray-pointer
# and reset synchronizers are covered by the separate zero-warning CDC report.
set_clock_groups -asynchronous -group {vid_clk_dvi2} -group {process_clk_150} -group {hdmi_tx_slow_clk}

#set_clock_groups -exclusive -group {i_sysclk} -group {jtag_inst1_TCK}                       2.500           -0.197           (R-R)

#set_clock_groups -exclusive -group {i_sysclk_div_2} -group {jtag_inst1_TCK}

#set_clock_groups -exclusive -group {jtag_inst1_TCK} -group {i_hbramClk_fb i_hbramClk_cal i_hbramClk_cal i_hbramClk90} -group {io_systemClk} -group {i_mipi_rx_pclk}

# GPIO Constraints
####################

# JTAG Constraints
####################
# The generated debugger crosses between the external JTAG clock and the
# LA/VIO sample clock through its own CDC logic. They are unrelated clocks.
set_clock_groups -asynchronous -group {vid_clk_dvi2} -group {jtag_inst1_TCK}
set_output_delay -clock jtag_inst1_TCK -max 1.519 [get_ports {jtag_inst1_TDO}]
set_output_delay -clock jtag_inst1_TCK -min 0.495 [get_ports {jtag_inst1_TDO}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -max 0.144 [get_ports {jtag_inst1_CAPTURE}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -min 0.077 [get_ports {jtag_inst1_CAPTURE}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -max 0.234 [get_ports {jtag_inst1_SEL}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -min 0.025 [get_ports {jtag_inst1_SEL}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -max 0.197 [get_ports {jtag_inst1_SHIFT}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -min 0.055 [get_ports {jtag_inst1_SHIFT}]


set_input_delay -clock_fall -clock jtag_inst1_TCK -max 2.822 [get_ports {jtag_inst1_TDI}]
set_input_delay -clock_fall -clock jtag_inst1_TCK -min 1.505 [get_ports {jtag_inst1_TDI}]
