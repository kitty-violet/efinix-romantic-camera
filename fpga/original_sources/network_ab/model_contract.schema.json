{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ti60-model-contract-v1.schema.json",
  "title": "Ti60 single Model B shared mathematical contract v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ti60-model-contract-v1"
    },
    "version": {
      "const": 1
    },
    "model_id": {
      "const": "B_BALANCED_DECODER_8_16_32_R3"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "const": {
        "shape_hwc": [
          720,
          1280,
          3
        ],
        "layout": "HWC_RGB",
        "integer": "signed_int8_zero_point_0",
        "u8_to_integer": "u8_minus_128",
        "real_scale": [
          1,
          128
        ]
      }
    },
    "output": {
      "const": {
        "node": "rgb_head",
        "shape_hwc": [
          720,
          1280,
          3
        ],
        "integer": "signed_int8_zero_point_0",
        "integer_to_u8": "clamp_i8_then_plus_128",
        "real_scale": [
          1,
          128
        ],
        "float_clamp": [
          -1,
          0.9921875
        ],
        "vgg_rgb01": "(128*x+128)/255"
      }
    },
    "numeric": {
      "const": {
        "weight_quantization": "symmetric_int8_per_output_channel_zero_0",
        "activation_quantization": "symmetric_int8_per_tensor_zero_0",
        "bias": "int32_in_input_scale_times_weight_scale_domain",
        "bias_add": "signed33_then_saturate_int32",
        "requantization": {
          "field_bits": 32,
          "effective_signed_bits": 18,
          "fraction_bits": 17,
          "rounding": "nearest_half_away_from_zero",
          "saturation": "int8_after_round_then_relu_if_enabled"
        },
        "residual": {
          "algorithm": "align_each_branch_to_common_int32_then_signed33_sum_saturate_i32_then_single_q17_to_int8",
          "common_scale": "positive_real_scale_of_aligned_int32_operands",
          "rounding": "nearest_half_away_from_zero",
          "branch_alignment_saturation": "int32",
          "sum": "signed33_then_saturate_int32",
          "post_add_activation": "none",
          "runtime_parameters": "UNDEFINED_UNTIL_CALIBRATION_QAT",
          "alignment_encoding": null,
          "hardware_status": "OPEN_PRODUCTION_RESIDUAL_ADAPTER"
        },
        "batch_norm_folding": "eval_running_statistics_fold_into_each_conv_weights_and_bias_before_quantization",
        "runtime_scales": "UNDEFINED_UNTIL_CALIBRATION_QAT"
      }
    },
    "hardware": {
      "const": {
        "oc_lanes": 8,
        "legal_terms": [
          8,
          9,
          16,
          27,
          32
        ],
        "weight_layout": "OC8_ICblock8_ky_kx_IC_lane;DW_OC8_ky_kx_lane",
        "tile_output_width": 320,
        "production_scheduler_status": "OPEN",
        "gesture_24_channel_mapping": "OPEN_SEPARATE_CONTRACT"
      }
    },
    "decisions": {
      "type": "object",
      "properties": {
        "frozen_on": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "bn": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "string",
          "minLength": 1
        },
        "output_domain": {
          "type": "string",
          "minLength": 1
        },
        "residual": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "frozen_on",
        "status",
        "bn",
        "activation",
        "output_domain",
        "residual",
        "sources"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 29,
      "maxItems": 29
    }
  },
  "required": [
    "schema",
    "version",
    "model_id",
    "description",
    "scope",
    "input",
    "output",
    "numeric",
    "hardware",
    "decisions",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "kind": {
          "enum": [
            "conv3x3",
            "dw3x3",
            "pw1x1",
            "nearest_x2",
            "residual_add"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 2
        },
        "channels": {
          "enum": [
            3,
            8,
            16,
            32
          ]
        },
        "kernel": {
          "enum": [
            0,
            1,
            3
          ]
        },
        "stride": {
          "enum": [
            1,
            2
          ]
        },
        "padding": {
          "enum": [
            "none",
            "replicate_1"
          ]
        },
        "training_bias": {
          "type": "boolean"
        },
        "batch_norm": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "epsilon": {
              "type": "number",
              "minimum": 1e-9
            },
            "momentum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "affine": {
              "const": true
            },
            "track_running_stats": {
              "const": true
            }
          },
          "required": [
            "enabled",
            "epsilon",
            "momentum",
            "affine",
            "track_running_stats"
          ],
          "additionalProperties": false
        },
        "activation": {
          "enum": [
            "none",
            "relu",
            "clamp_rgb"
          ]
        },
        "quantization": {
          "enum": [
            "output_int8",
            "inherit_scale",
            "residual_int8"
          ]
        },
        "legacy_name": {
          "type": "string",
          "minLength": 1
        },
        "legacy_operator": {
          "enum": [
            "conv3x3",
            "dw3x3",
            "pw1x1",
            "dw3x3_s1+pw1x1",
            "dw3x3_s2+pw1x1",
            "nearest_x2",
            "residual_add"
          ]
        },
        "legacy_note": {
          "type": "string"
        },
        "fusion_group": {
          "enum": [
            "encoder",
            "residual1",
            "residual2",
            "residual3",
            "decoder"
          ]
        },
        "ddr_boundary": {
          "enum": [
            "stream_internal",
            "commit_feature0",
            "commit_pingpong_feature",
            "virtual_copy",
            "commit_rgb_frame"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "inputs",
        "channels",
        "kernel",
        "stride",
        "padding",
        "training_bias",
        "batch_norm",
        "activation",
        "quantization",
        "legacy_name",
        "legacy_operator",
        "legacy_note",
        "fusion_group",
        "ddr_boundary"
      ],
      "additionalProperties": false
    }
  }
}
